APP_NAME=SENA
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Jayapura
LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=electcount_staging
DB_USERNAME=electcount_staging
DB_PASSWORD=
DB_SSLMODE=prefer

CACHE_STORE=redis
RATE_LIMITER_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_QUEUE_BLOCK_FOR=5
REDIS_QUEUE_RETRY_AFTER=120
REQUIRE_BACKGROUND_HEARTBEATS=true
DASHBOARD_CACHE_TTL_SECONDS=5

FILESYSTEM_DISK=s3
EVIDENCE_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=sena-staging-evidence
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
# Leave empty for the disposable local MinIO stack. Production requires KMS-backed encryption.
AWS_SERVER_SIDE_ENCRYPTION=

MALWARE_SCAN_ENABLED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=30

TESSERACT_BINARY=tesseract
TESSERACT_LANGUAGE=eng
TESSERACT_PSM=6
TESSERACT_TIMEOUT=60

STAGING_DB_DATABASE=electcount_staging
STAGING_DB_USERNAME=electcount_staging
STAGING_DB_PASSWORD=
STAGING_MINIO_ACCESS_KEY=
STAGING_MINIO_SECRET_KEY=
STAGING_S3_BUCKET=sena-staging-evidence
STAGING_APP_PORT=8080
