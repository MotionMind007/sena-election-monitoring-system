APP_NAME=SENA
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://sena.example.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_TIMEZONE=Asia/Jayapura

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=electcount
DB_USERNAME=electcount_app
DB_PASSWORD=
DB_SSLMODE=require

CACHE_STORE=redis
RATE_LIMITER_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_LIFETIME=120

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_QUEUE_BLOCK_FOR=5
REDIS_QUEUE_RETRY_AFTER=120

REQUIRE_BACKGROUND_HEARTBEATS=true
BACKGROUND_HEARTBEAT_MAX_AGE=180
DASHBOARD_CACHE_TTL_SECONDS=5

FILESYSTEM_DISK=s3
EVIDENCE_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-2
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_SERVER_SIDE_ENCRYPTION=AES256

MALWARE_SCAN_ENABLED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=30

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.id
MAIL_FROM_NAME=SENA

TESSERACT_BINARY=tesseract
TESSERACT_LANGUAGE=eng
TESSERACT_PSM=6
TESSERACT_TIMEOUT=60
